{
  "name": "@muni-kypo-crp/hurdling-visualization",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint && npm run prettier-check",
    "e2e": "ng e2e",
    "api": "json-server -w ./utils/json-server/db.js --routes ./utils/json-server/routes.json --middlewares ./utils/json-server/server.js",
    "prettier-check": "prettier --check \"projects/**/*.ts\"",
    "prettier-fix": "prettier --write \"./projects/**/*.ts\"",
    "build-example-app": "ng build example-app --configuration production",
    "build-library": "ng build kypo-trainings-hurdling-viz-lib --configuration production && cp ./src/styles.css ./dist/kypo-trainings-hurdling-viz-lib",
    "create-package": "cd dist/kypo-trainings-hurdling-viz-lib && npm pack",
    "build-and-pack": "npm install && npm run build-library && npm run create-package",
    "ci-update-version": "cd ./projects/kypo-trainings-hurdling-viz-lib/ && npm version $TAG_VERSION",
    "ci-build-and-pack": "npm ci --cache .npm --prefer-offline && npm run build-library && npm run create-package",
    "ci-publish-package": "cd dist/kypo-trainings-hurdling-viz-lib && npm publish",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/material": "^15.0.0",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@muni-kypo-crp/d3-service": "~15.0.1",
    "@sentinel/auth": "~15.0.0",
    "angular-oauth2-oidc": "^15.0.1",
    "angular-oauth2-oidc-jwks": "^15.0.1",
    "core-js": "^3.33.2",
    "d3": "^7.8.5",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.11.6"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.1502.10",
    "@angular-devkit/build-angular": "^15.2.10",
    "@angular-eslint/builder": "~15.2.1",
    "@angular-eslint/eslint-plugin": "~15.2.1",
    "@angular-eslint/eslint-plugin-template": "~15.2.1",
    "@angular-eslint/schematics": "~15.2.1",
    "@angular-eslint/template-parser": "~15.2.1",
    "@angular/cli": "^15.2.10",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/language-service": "^15.2.10",
    "@types/d3": "^7.4.0",
    "@types/jasmine": "~4.0.3",
    "@types/jasminewd2": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "eslint": "^8.19.0",
    "jasmine-core": "~4.2.0",
    "jasmine-spec-reporter": "~7.0.0",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.1",
    "karma-cli": "~2.0.0",
    "karma-coverage-istanbul-reporter": "~3.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.0.0",
    "ng-packagr": "^15.2.2",
    "prettier": "^2.7.1",
    "protractor": "~7.0.0",
    "ts-node": "~3.2.0",
    "typescript": "~4.8.2",
    "husky": "^8.0.0"
  },
  "optionalDependencies": {
    "@esbuild/android-arm": "^0.19.5",
    "fsevents": "2.1.2"
  }
}
