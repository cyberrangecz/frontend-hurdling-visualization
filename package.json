{
  "name": "d3-visualization",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "postinstall": "ngcc --properties es2015 browser module main --first-only --create-ivy-entry-points",
    "lib-build": "ng build kypo2-trainings-hurdling-viz-lib --prod && cp ./src/styles.css ./dist/kypo2-trainings-hurdling-viz-lib",
    "lib-copy": "cp -a ./dist/kypo2-trainings-hurdling-viz-lib/. ../kypo2-trainings-hurdling-viz-lib-package/",
    "cp": "rm -rf ../kypo2-visualization-dashboard/node_modules/kypo2-trainings-hurdling-viz-lib/* && cp -a ./dist/kypo2-trainings-hurdling-viz-lib/. ../kypo2-visualization-dashboard/node_modules/kypo2-trainings-hurdling-viz-lib",
    "publish": "npm run lib-build && cd dist/kypo2-trainings-hurdling-viz-lib/. && npm publish --registry=http://kypo-storage.ics.muni.cz:8081/repository/npm-hosted"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^9.0.0",
    "@angular/cdk": "^9.0.0",
    "@angular/common": "^9.0.0",
    "@angular/compiler": "^9.0.0",
    "@angular/core": "^9.0.0",
    "@angular/forms": "^9.0.0",
    "@angular/material": "^9.0.0",
    "@angular/platform-browser": "^9.0.0",
    "@angular/platform-browser-dynamic": "^9.0.0",
    "@angular/router": "^9.0.0",
    "angular-oauth2-oidc": "^8.0.4",
    "d3": "^5.15.0",
    "csirt-mu-d3-service": "9.0.0",
    "core-js": "^2.4.1",
    "kypo2-auth": "9.0.0",
    "rxjs": "^6.5.4",
    "tslib": "^1.10.0",
    "zone.js": "~0.10.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.900.1",
    "@angular-devkit/build-ng-packagr": "~0.900.1",
    "@angular/cli": "~9.0.1",
    "@angular/compiler-cli": "^9.0.0",
    "@angular/language-service": "^9.0.0",
    "@types/jasmine": "~2.5.53",
    "@types/jasminewd2": "^2.0.5",
    "@types/node": "^12.11.1",
    "@types/d3": "^5.7.2",
    "codelyzer": "^5.1.2",
    "jasmine-core": "~2.6.2",
    "jasmine-spec-reporter": "~4.1.0",
    "karma": "^3.1.1",
    "karma-chrome-launcher": "~2.1.1",
    "karma-cli": "~1.0.1",
    "karma-coverage-istanbul-reporter": "^1.4.3",
    "karma-jasmine": "^1.1.2",
    "karma-jasmine-html-reporter": "^0.2.2",
    "ng-packagr": "^9.0.0",
    "protractor": "^5.4.1",
    "ts-node": "~3.2.0",
    "tslint": "~5.3.2",
    "typescript": "~3.7.5"
  }
}
